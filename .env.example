# =====================================================================
# Argus RAG 平台环境变量模板
# 复制为 .env 并填入真实值。.env 已被 gitignore，严禁提交真实密钥。
# =====================================================================

# ---- MySQL 8.0（业务库）----
# root 密码（容器首次启动时自动创建）
MYSQL_ROOT_PASSWORD=change-me-strong-password
# 对外暴露端口（可不改）
MYSQL_PORT=3306

# ---- PostgreSQL 16 + pgvector（向量库）----
VECTOR_DB_USER=argus
VECTOR_DB_PASSWORD=change-me-vector-password
VECTOR_DB_PORT=5432

# ---- MinIO（文档对象存储）----
MINIO_ACCESS_KEY=argusminio
MINIO_SECRET_KEY=change-me-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Elasticsearch 8（关键词检索）----
ES_PORT=9200

# ---- DashScope（embedding + LLM，必填）----
# 开通地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---- 后端 ----
BACKEND_PORT=10001
# JWT 签名密钥（至少 32 位随机字符串）
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
